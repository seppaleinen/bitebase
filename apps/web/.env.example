# Canonical site URL (used for sitemap, canonical links, OG image URLs)
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitebase
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Optional: API key for the AI backend (default is "ollama" for local servers like Ollama/omlx)
# Set this when using a remote or authenticated OpenAI-compatible endpoint
OLLAMA_API_KEY=
TAVILY_API_KEY=tvly-your-key-here
# Optional: self-hosted SearXNG instance (checked before Tavily when both are set)
SEARXNG_BASE_URL=
# Max number of lessons to generate in parallel (default 3; set to 1 for sequential)
LESSON_GENERATION_CONCURRENCY=3
# Admin email for accessing admin routes (default: davidbaeriksson@gmail.com)
ADMIN_EMAIL=davidbaeriksson@gmail.com
